# Copy this file to .env and fill in your keys. .env is gitignored.

# Jev, through TypeSafe's own API (https://api.typesafe.ai), run as jev; keys come from TypeSafe
JEV_API_KEY=

# Jev, through the third-party provider jevmodel.org, run as jev-3rdparty; keys come from the jevmodel.org Dashboard
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://jevmodel.org

# Gemini 3.8 Flash and Gemini 4 Argon, through Google's Gemini API, run as gemini, gemini-lowthink and gemini-argon
GEMINI_API_KEY=

# Gemma, through Google's Gemini API on its own key, run as gemma
GEMMA_API_KEY=

# GPT-6 Luna, through OpenAI's Decisions API (also gpt and gpt-sol, through the Responses API)
OPENAI_API_KEY=

# Claude Haiku 5.5, through Anthropic's Messages API, run as haiku
ANTHROPIC_API_KEY=

# Perplexity's decision model, through its Decisions API, run as pplx; and GLM-5.3-Flash, through its Agent API, run as glm-flash
PERPLEXITY_API_KEY=

# Decision models through OpenRouter's Decisions API, run as mercury, d1-ultra, microsoft and clef
OPENROUTER_API_KEY=

# Baseten's mammoth-1, through Baseten's System One API, run as mammoth; keys come from app.baseten.co
BASETEN_API_KEY=

# Kev runs as a local server speaking the same API as Jev (see README)
KEV_BASE_URL=http://127.0.0.1:8009
